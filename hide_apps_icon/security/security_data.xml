<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_groups_privilege_hide_apps_icon" model="res.groups.privilege">
            <field name="name">App Dashboard Visibility</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="sequence">50</field>
        </record>

        <record id="group_manage_app_visibility" model="res.groups">
            <field name="name">Manage App Dashboard Visibility</field>
            <field name="privilege_id" ref="res_groups_privilege_hide_apps_icon"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>

